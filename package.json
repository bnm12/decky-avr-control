{
  "name": "avr-control",
  "version": "0.4.0",
  "description": "Quick Access controls for network receivers and Home Assistant media players; eISCP verified on Pioneer VSX-935, other drivers experimental.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.18.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.2.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "author": "bnm12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bnm12/decky-avr-control.git"
  }
